{
  "name": "@aix/mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The AIX marketplace MCP server (Streamable HTTP, OAuth 2.1, MCP Apps panels) that proxies installed apps' tools.",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "~1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aix/cli": "workspace:*",
    "@aix/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "tsx": "^4.23.15"
  }
}
