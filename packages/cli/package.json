{
  "name": "@aix/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "The aix developer CLI: login, app init/dev/validate/publish, keys, prices.",
  "bin": {
    "aix": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepack": "node scripts/bundle-templates.mjs"
  },
  "dependencies": {
    "@aix/manifest": "workspace:*",
    "commander": "^15.1.0"
  },
  "license": "MIT",
  "author": "AIX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adnanehaloui/-haloui-form-core.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "aix",
    "cli",
    "mcp",
    "skills"
  ]
}
