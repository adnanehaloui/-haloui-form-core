{
  "name": "@aix/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The aix developer CLI: login, app init/dev/validate/publish, keys, prices.",
  "bin": {
    "aix": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aix/manifest": "workspace:*",
    "commander": "^15.1.0"
  }
}
