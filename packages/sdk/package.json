{
  "name": "@aix/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Server-side Node SDK for AIX developers: auth.verify, entitlements, wallet hold/capture/release, usage, webhooks.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
