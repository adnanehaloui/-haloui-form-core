{
  "name": "@aix/manifest",
  "version": "0.1.0",
  "type": "module",
  "description": "Zod schema and validator for aix.json app manifests.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "author": "AIX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adnanehaloui/-haloui-form-core.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "aix",
    "manifest"
  ]
}
