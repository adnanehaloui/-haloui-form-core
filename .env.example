# Copy to .env — never commit real values.
DATABASE_URL=postgres://aix:aix@localhost:5432/aix
# 32-byte base64 key for AES-256-GCM encryption of stored third-party secrets
AIX_ENCRYPTION_KEY=
# Session / token signing secret
AIX_SESSION_SECRET=
# Stripe (TEST MODE ONLY)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Google OAuth (sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URLs
AIX_WEB_URL=http://localhost:3000
AIX_API_URL=http://localhost:4000
AIX_GATEWAY_URL=http://localhost:4100
