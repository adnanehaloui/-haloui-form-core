# Copy to .env and fill in. NEVER commit .env.
# Anything marked (REQUIRED for real use) has a dev fallback so you can start without it.

# --- Database (docker compose default) ---
DATABASE_URL=postgres://aix:aix@localhost:5432/aix
TEST_DATABASE_URL=postgres://aix:aix@localhost:5432/aix_test

# --- Public URLs ---
AIX_WEB_URL=http://localhost:3000
AIX_API_URL=http://localhost:4000
AIX_GATEWAY_URL=http://localhost:4100

# --- Platform keys (REQUIRED for real use) ---
# Generate both with:  pnpm --filter @aix/api keys:generate
# 32-byte base64 key for AES-256-GCM encryption of stored third-party secrets
AIX_ENCRYPTION_KEY=
# Ed25519 PKCS#8 PEM (newlines as \n). Signs OAuth tokens, user tokens and app packages.
AIX_SIGNING_PRIVATE_KEY=

# Comma-separated emails that can use the internal admin console (review queue, refunds)
AIX_ADMIN_EMAILS=admin@aix.local

# --- Stripe (TEST MODE ONLY: sk_test_… keys) ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4000/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# --- Google sign-in (optional; magic link works without it) ---
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Mailpit from docker compose; inbox at http://localhost:8025) ---
AIX_MAILER=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM=AIX <no-reply@aix.local>

# --- Local dev helpers ---
# 1 = enable /_dev endpoints and fake Stripe checkout when STRIPE_SECRET_KEY is empty. Never in production.
AIX_DEV_ENDPOINTS=1
AIX_STORAGE_DIR=./.storage

# Optional: git URL of the exported Claude Code plugin marketplace (pnpm --filter @aix/api job:export-marketplace)
AIX_PLUGIN_MARKETPLACE_URL=

# --- Package storage: fs (default, local disk) or s3 (AWS S3 / Cloudflare R2 / MinIO) ---
AIX_STORAGE=fs
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# --- Monitoring: bearer token for GET /metrics (Prometheus). Required in production. ---
# AIX_METRICS_TOKEN is also printed by pnpm keys:generate
AIX_METRICS_TOKEN=

# --- Worker: also export the Claude Code plugin marketplace hourly to this folder (optional) ---
AIX_MARKETPLACE_DIR=

# --- Gateway ↔ API trust (REQUIRED in production; pnpm keys:generate prints one) ---
# The API only honours AI-host OAuth tokens on requests that carry this secret (i.e. from the gateway).
AIX_GATEWAY_SERVICE_SECRET=
# Reverse-proxy hops in front of the API (e.g. 1 behind one load balancer). 0 = direct.
AIX_TRUST_PROXY=0
