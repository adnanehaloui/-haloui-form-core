{
  "name": "aix",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test --concurrency=1",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @aix/db db:migrate",
    "seed": "pnpm --filter @aix/api seed",
    "keys:generate": "pnpm --filter @aix/api keys:generate",
    "e2e": "playwright test --trace off",
    "aix": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12"
  }
}